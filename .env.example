# Configuration (all optional — sensible defaults apply)

# Where the SQLite database + caches live
CNN_DATA_DIR=./data
# CNN_DB_PATH=./data/neuro.sqlite

# HTTP/WebSocket server
CNN_HOST=127.0.0.1
CNN_PORT=4319

# On-device semantic embeddings (transformers.js MiniLM).
# 1 = enabled (richer semantic links), 0 = lexical only (lowest resources)
CNN_EMBEDDINGS=1

# Cosine similarity threshold for forming semantic "similar" edges (0-1)
CNN_AUTOLINK_THRESHOLD=0.62

# Optional: override model cache location
# CNN_MODEL_CACHE=~/.cache/ai-context-neuro-network/models
