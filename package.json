{
  "name": "ai-context-neuro-network",
  "version": "0.1.0",
  "description": "A local-first neuro network that captures, connects, visualizes and grows context from your AI chats.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server/main.ts",
    "start": "node dist/server/main.js",
    "mcp": "tsx src/mcp/main.ts",
    "import:chatgpt": "tsx src/ingest/cli.ts chatgpt",
    "import:copilot": "tsx src/ingest/cli.ts copilot",
    "analyze": "tsx src/analyze/cli.ts",
    "embed:backfill": "tsx src/embeddings/backfill.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "test": "node --test --import tsx dist/**/*.test.js || node --test --import tsx \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aflsolutions/graphology-communities-leiden": "^1.1.1",
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.3.4",
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-layout-forceatlas2": "^0.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "sigma": "^4.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "onnxruntime-node": true,
    "fsevents": true,
    "protobufjs": false
  }
}
